{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XHS Tauri macOS Probe",
  "version": "0.1.0",
  "identifier": "local.xhs.tauri.macosprobe",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      { "label": "main", "title": "XHS macOS F WebView Probe", "width": 1180, "height": 800, "center": true }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "XHS feasibility fixture",
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
