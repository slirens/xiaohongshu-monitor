{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XHS Monitor F Preview",
  "version": "1.0.9",
  "identifier": "com.xhsmonitor.preview",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      { "label": "main", "title": "XHS Monitor · F UI Preview", "width": 1180, "height": 800, "center": true }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "slirens",
    "windows": { "nsis": { "installMode": "currentUser" } },
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
